# Copie para .env (ou cadastre no painel do provedor) e ajuste.
# Rodando local nao precisa de nenhuma: os padroes de settings.py bastam.

# Obrigatorias em producao
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=0
ALLOWED_HOSTS=estudos.exemplo.com
CSRF_TRUSTED_ORIGINS=https://estudos.exemplo.com

# O provedor normalmente injeta esta sozinho ao criar o Postgres.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Disco persistente, para os anexos nao sumirem no proximo deploy.
# MEDIA_ROOT=/dados/arquivos

# Desligue so se o proprio provedor ja forca https antes de chegar aqui.
# SECURE_SSL_REDIRECT=1
